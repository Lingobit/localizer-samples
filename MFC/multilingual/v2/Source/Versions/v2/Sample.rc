IDD_MAIN DIALOGEX 0,0,420,250
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "MFC Localization Sample"
MENU IDR_MAIN_MENU
FONT 9,"Segoe UI"
BEGIN
 GROUPBOX "Page setup",IDC_PAGE_GROUP,12,8,194,150
 LTEXT "Orientation:",IDC_ORIENTATION,20,24,58,12
