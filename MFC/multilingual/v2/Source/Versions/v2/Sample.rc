 COMBOBOX IDC_SCALE,100,84,98,70,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 AUTOCHECKBOX "Print on both sides",IDC_DUPLEX,20,106,178,12
 AUTOCHECKBOX "Include document properties",IDC_PROPERTIES,20,122,178,12
 GROUPBOX "Output",IDC_OUTPUT_GROUP,214,8,194,150
 LTEXT "&File type:",IDC_FORMAT_LABEL,222,26,70,12
 COMBOBOX IDC_FORMAT,294,24,106,70,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "&Quality:",IDC_QUALITY_LABEL,222,46,70,12
 COMBOBOX IDC_QUALITY,294,44,106,70,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "Saved profiles:",IDC_PROFILES_LABEL,222,68,178,12
 LISTBOX IDC_PROFILES,222,84,178,66,LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
 GROUPBOX "After export",IDC_AFTER_GROUP,12,158,396,44
 AUTOCHECKBOX "&Open the exported file",IDC_OPEN_FILE,20,174,178,12
 AUTOCHECKBOX "Show a desktop no&tification",IDC_DESKTOP_NOTICE,222,174,178,12
 AUTOCHECKBOX "Open folder after export",IDC_OPEN_FOLDER,20,188,178,12
 LTEXT "Exported 12 pages to sample.pdf.",IDC_RESOURCE_MESSAGE,12,206,396,12
 PUSHBUTTON "Save export profile",IDC_SAVE_PROFILE,12,220,112,14
 PUSHBUTTON "Restore defaults",IDC_RESTORE_DEFAULTS,136,220,92,14
 PUSHBUTTON "Export options...",IDC_EXPORT_OPTIONS,290,220,112,14
 LTEXT "Ready for preview",IDC_STATUS,12,236,396,8
END
IDD_EXPORT DIALOGEX 0,0,360,194
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Export options"
FONT 9,"Segoe UI"
BEGIN
 GROUPBOX "Document options",-1,12,10,336,120
 LTEXT "Pages:",IDC_EXPORT_FORMAT_LABEL,22,32,84,12
 COMBOBOX IDC_PAGES,110,30,222,70,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "Save in:",IDC_FOLDER_LABEL,22,56,84,12
 COMBOBOX IDC_FOLDER,110,54,222,70,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 AUTOCHECKBOX "Embed fonts in the document",IDC_EMBED_FONTS,22,80,310,12
 AUTOCHECKBOX "Preserve links and bookmarks",IDC_PRESERVE_LINKS,22,104,310,12
 LTEXT "Settings apply to the next export.",IDC_EXPORT_NOTE,12,146,336,12
 PUSHBUTTON "Close",IDCANCEL,12,174,54,14
 PUSHBUTTON "&Page setup",IDC_PAGE_SETUP,172,174,48,14
 DEFPUSHBUTTON "&Export",IDC_EXPORT_RUN,228,174,78,14
END
