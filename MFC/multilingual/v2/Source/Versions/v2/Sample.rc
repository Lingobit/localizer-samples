IDR_MAIN_MENU MENU
BEGIN
 POPUP "&File"
 BEGIN
  MENUITEM "&Preview\tCtrl+P",ID_FILE_PREVIEW
  MENUITEM "&Export...\tCtrl+E",ID_FILE_EXPORT
  MENUITEM "&Save export profile\tCtrl+S",ID_SAMPLE_SAVE
  MENUITEM SEPARATOR
  MENUITEM "E&xit",ID_FILE_EXIT
 END
 POPUP "&Language"
 BEGIN
  MENUITEM "English",ID_LANGUAGE_FIRST
 END
 POPUP "&Help"
 BEGIN
  MENUITEM "Export &guide",ID_HELP_GUIDE
 END
END

IDR_MENU MENU
BEGIN
 POPUP "&Export actions"
 BEGIN
  MENUITEM "&Preview\tCtrl+P",ID_FILE_PREVIEW
  MENUITEM "&Export...\tCtrl+E",ID_FILE_EXPORT
  MENUITEM "&Save export profile\tCtrl+S",ID_SAMPLE_SAVE
  MENUITEM SEPARATOR
  MENUITEM "Export &guide",ID_HELP_GUIDE
  MENUITEM SEPARATOR
  MENUITEM "E&xit",ID_FILE_EXIT
 END
END
