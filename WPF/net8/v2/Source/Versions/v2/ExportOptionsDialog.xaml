<Window x:Class="WpfLocalization.ExportOptionsDialog" x:Uid="ExportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Export options" Width="656" Height="414" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <Grid Margin="12" Background="#F7F8FA"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock x:Uid="ExportHeading" Text="Prepare a document for export" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
  <GroupBox x:Uid="ExportGroup" Header="Document options" Grid.Row="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="38"/><RowDefinition Height="38"/><RowDefinition Height="38"/><RowDefinition Height="38"/></Grid.RowDefinitions>
   <Label x:Uid="ExportFormatLabel" Content="Export format:" Style="{StaticResource FieldLabel}"/><ComboBox Grid.Column="1" SelectedIndex="0"><ComboBoxItem x:Uid="ExportPdf" Content="PDF document"/><ComboBoxItem x:Uid="ExportImage" Content="Image file"/></ComboBox>
   <Label x:Uid="FolderLabel" Grid.Row="1" Content="Output folder:" Style="{StaticResource FieldLabel}"/><TextBox x:Uid="FolderValue" Grid.Row="1" Grid.Column="1" Text="Sample output"/>
   <CheckBox x:Uid="EmbedFonts" Grid.Row="2" Grid.ColumnSpan="2" Content="Embed fonts in the document" VerticalAlignment="Center"/>
   <CheckBox x:Uid="PreserveLinks" Grid.Row="3" Grid.ColumnSpan="2" Content="Preserve links and bookmarks" VerticalAlignment="Center"/>
  <CheckBox x:Uid="OpenFolder" Grid.Row="4" Grid.ColumnSpan="2" Content="Open folder after export" VerticalAlignment="Center"/></Grid></GroupBox>
  <TextBlock x:Name="ResultText" x:Uid="ExportNote" Grid.Row="2" Text="This sample translates resources. It does not print documents." TextWrapping="Wrap" Margin="0,12"/>
  <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="96"/><ColumnDefinition Width="12"/><ColumnDefinition Width="136"/></Grid.ColumnDefinitions><Button x:Uid="ExportClose" Content="Close" Click="CloseDialog" HorizontalAlignment="Left" IsCancel="True"/><Button x:Uid="PageSetupButton" Grid.Column="1" Content="_Page setup" Click="PageSetup"/><Button x:Uid="ExportButton" Grid.Column="3" Content="_Export" Click="Export" IsDefault="True"/></Grid>
 </Grid>
</Window>